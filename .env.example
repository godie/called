[TEMPLATE]
# === Silence Detection ===
# Enable silence detection to skip transcription of silent chunks
SILENCE_DETECTION_ENABLED=true

# Silence threshold in dB (RMS). Chunks below this are skipped.
SILENCE_THRESHOLD_DB=-40.0

# Enable periodic recalibration of the silence threshold
# When enabled, the threshold adapts to the tracked noise floor over time
SILENCE_RECALIBRATION_ENABLED=true

# Recalibration interval in seconds (how often to recalibrate)
SILENCE_RECALIBRATION_INTERVAL=30.0

# dB margin above noise floor for the recalibrated threshold
# Higher margin = less sensitive (fewer false positives)
SILENCE_RECALIBRATION_MARGIN_DB=10.0

# === Audio Configuration ===
# Microphone device index (auto-detected if not set)
MIC_DEVICE_INDEX=

# System audio device index (BlackHole on macOS)
SYSTEM_AUDIO_DEVICE_INDEX=

# Sample rate in Hz (16000 is sufficient for Whisper)
SAMPLE_RATE=16000

# Audio chunk duration in seconds (1-3 recommended)
CHUNK_DURATION=2

# Number of audio channels (1 for mono)
CHANNELS=1

# === Ring Buffer Configuration ===
# Ring buffer capacity in number of chunks
RING_BUFFER_CAPACITY=128

# === Transcription Configuration ===
# Model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base

# Device for inference: auto, cpu, cuda
WHISPER_DEVICE=auto

# Compute type: default, int8, float16, int8_float16
WHISPER_COMPUTE_TYPE=default

# Beam size for transcription
WHISPER_BEAM_SIZE=5

# Force a specific language (e.g., "en", "es") or empty for auto-detection
WHISPER_LANGUAGE=

# Speech detection: min probability for language detection
VAD_THRESHOLD=0.5

# Minimum seconds of speech to trigger transcription
MIN_SPEECH_DURATION=0.5

# Silence duration in seconds to split segments
SILENCE_DURATION=1.0

# === Queue Configuration ===
# Maximum queue size (backpressure)
QUEUE_MAX_SIZE=64

# Number of transcription workers
NUM_WORKERS=1

# === Audio Archiving ===
# Codec for compressed audio storage: opus (recommended)
AUDIO_ARCHIVE_CODEC=opus

# Bitrate for compressed audio: 12k, 16k, 24k
AUDIO_ARCHIVE_BITRATE=16k

# Save raw WAV files (debug only, uses significant disk space)
SAVE_RAW_AUDIO=false

# Save compressed audio for archiving
SAVE_COMPRESSED_AUDIO=true

# Directory for audio archives
AUDIO_ARCHIVE_DIR=./audio_archive

# === Output Configuration ===
# Output directory for transcript files
OUTPUT_DIR=./transcripts

# Rotate transcript files every N seconds (3600 = 1 hour)
ROTATION_INTERVAL=3600

# === Metrics Configuration ===
# Enable metrics collection
METRICS_ENABLED=true

# Metrics reporting interval in seconds
METRICS_INTERVAL=30

# === Checkpoint Configuration ===
# Enable automatic checkpoint recovery on startup
CHECKPOINT_RECOVERY_ENABLED=true

# Save checkpoint every N seconds
CHECKPOINT_INTERVAL=60

# Checkpoint directory
CHECKPOINT_DIR=./checkpoints

# === Logging ===
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (empty for stdout only)
LOG_FILE=
